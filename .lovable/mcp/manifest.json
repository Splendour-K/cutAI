{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://bkhdorwhekifuapiisxk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "chat-edit-pro",
      "version": "0.1.0",
      "title": "Chat Edit Pro"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List video projects",
        "description": "List the signed-in user's video editing projects, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum number of projects to return (default 20)."
            },
            "status": {
              "type": "string",
              "description": "Optional status filter, e.g. draft, ready, exporting."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Get project details",
        "description": "Fetch one of the signed-in user's video projects, including its caption settings and recent edit history.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "description": "The project's ID."
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_video_analysis",
        "title": "Get video analysis",
        "description": "Fetch the AI analysis for a project: transcription, pauses, key moments, scene changes, and suggested edits.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "description": "The project's ID."
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_project",
        "title": "Create video project",
        "description": "Create a new video editing project for the signed-in user. The video file itself is uploaded in the app.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Project title."
            },
            "description": {
              "type": "string",
              "description": "Optional project description or brief."
            },
            "platform": {
              "type": "string",
              "enum": [
                "youtube",
                "instagram",
                "tiktok",
                "twitter",
                "linkedin",
                "custom"
              ],
              "description": "Target platform (default instagram)."
            },
            "content_type": {
              "type": "string",
              "enum": [
                "short",
                "long"
              ],
              "description": "Short-form or long-form content."
            },
            "aspect_ratio": {
              "type": "string",
              "enum": [
                "16:9",
                "9:16",
                "1:1",
                "4:5"
              ],
              "description": "Target aspect ratio."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_project",
        "title": "Update video project",
        "description": "Rename a project or update its description, platform, content type, aspect ratio, or status.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "description": "The project's ID."
            },
            "title": {
              "type": "string",
              "description": "New project title."
            },
            "description": {
              "type": "string",
              "description": "New project description."
            },
            "platform": {
              "type": "string",
              "enum": [
                "youtube",
                "instagram",
                "tiktok",
                "twitter",
                "linkedin",
                "custom"
              ],
              "description": "New target platform."
            },
            "content_type": {
              "type": "string",
              "enum": [
                "short",
                "long"
              ],
              "description": "New content type."
            },
            "aspect_ratio": {
              "type": "string",
              "enum": [
                "16:9",
                "9:16",
                "1:1",
                "4:5"
              ],
              "description": "New aspect ratio."
            },
            "status": {
              "type": "string",
              "description": "New project status, e.g. draft or ready."
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_project",
        "title": "Delete video project",
        "description": "Permanently delete one of the signed-in user's projects along with its analysis and edit history.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "description": "The project's ID."
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
